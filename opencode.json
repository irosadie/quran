{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["/Users/binarydev/.local/bin/serena", "start-mcp-server", "--context", "ide", "--project-from-cwd"],
      "enabled": true,
      "timeout": 60000
    },
    "headroom": {
      "type": "local",
      "command": ["/Users/binarydev/.local/bin/headroom", "mcp", "serve"],
      "enabled": true,
      "timeout": 60000
    },
    "quran-api": {
      "type": "local",
      "command": ["npx", "-y", "github:djalal/quran-mcp-server"],
      "enabled": true,
      "timeout": 60000
    },
    "graphify": {
      "type": "local",
      "command": ["graphify", ".", "--mcp"],
      "enabled": false,
      "timeout": 60000
    }
  }
}
